# Copy this file to .env and replace your_password_here.
# Git ignores .env, so the real password stays on your computer.
#
# postgresql+psycopg  = talk to PostgreSQL with the psycopg driver
# postgres            = the database user created by the PostgreSQL installer
# your_password_here  = the password you chose for that user
# localhost:5433      = PostgreSQL 18 on this computer. PostgreSQL 17 uses port 5432.
# student_management  = the dedicated application database. Do not use the postgres maintenance database.
#
# The application creates its tables in student_management.
# It does not create a PostgreSQL user and it does not change authentication.
# Create that database before starting the app. Do not put the real password in this file.

DATABASE_URL=postgresql+psycopg://postgres:your_password_here@localhost:5433/student_management

# Local Ollama. No API key is used.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Optional. Used once, only when no administrator account exists yet.
# Leave both blank and the application creates admin@studentmanagement.local
# and writes the generated password to .admin-credentials. Git ignores that file.
# Do not commit a real password here.
ADMIN_EMAIL=
ADMIN_PASSWORD=
