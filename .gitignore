# Local secrets. Keep .env.example, ignore the real .env file.
.env
.admin-credentials
.demo-credentials

# Virtual environment created by: py -3.11 -m venv .venv
.venv/

# Python cache and packaging files
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Editor and log files
.idea/
.vscode/
*.log

# Local database dumps and OS files
*.dump
*.sqlite
*.sqlite3
*.db
Thumbs.db
Desktop.ini
.DS_Store
